// stdlib/array.mira  —  MiraIDE Standard Array Library
// Written entirely in the Mira language.
// Usage: import "stdlib/array";
// ============================================================

// contains(arr, target) — Returns true if arr contains target
fn contains(arr, target) {
    let i = 0;
    while (i < length(arr)) {
        if (arr[i] == target) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// indexOf(arr, target) — Returns index of target, or -1 if not found
fn indexOf(arr, target) {
    let i = 0;
    while (i < length(arr)) {
        if (arr[i] == target) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// first(arr) — Returns first element
fn first(arr) {
    return arr[0];
}

// last(arr) — Returns last element
fn last(arr) {
    return arr[length(arr) - 1];
}

// printAll(arr) — Prints every element with its index
fn printAll(arr) {
    let i = 0;
    while (i < length(arr)) {
        print("[" + i + "] " + arr[i]);
        i = i + 1;
    }
}

// sumArray(arr) — Sum of all numeric elements
fn sumArray(arr) {
    let total = 0;
    let i = 0;
    while (i < length(arr)) {
        total = total + arr[i];
        i = i + 1;
    }
    return total;
}

// maxElement(arr) — Returns maximum element
fn maxElement(arr) {
    let best = arr[0];
    let i = 1;
    while (i < length(arr)) {
        if (arr[i] > best) {
            best = arr[i];
        }
        i = i + 1;
    }
    return best;
}

// minElement(arr) — Returns minimum element
fn minElement(arr) {
    let best = arr[0];
    let i = 1;
    while (i < length(arr)) {
        if (arr[i] < best) {
            best = arr[i];
        }
        i = i + 1;
    }
    return best;
}

// countOccurrences(arr, target) — Count how many times target appears
fn countOccurrences(arr, target) {
    let count = 0;
    let i = 0;
    while (i < length(arr)) {
        if (arr[i] == target) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

// joinToString(arr, sep) — Join array elements into a string with separator
fn joinToString(arr, sep) {
    let result = "";
    let i = 0;
    while (i < length(arr)) {
        if (i == 0) {
            result = arr[i];
        } else {
            result = result + sep + arr[i];
        }
        i = i + 1;
    }
    return result;
}
