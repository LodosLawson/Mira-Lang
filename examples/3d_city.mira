// ============================================================
// MiraIDE — 3D Mini City
// F5 ile çalıştır → Tarayıcıda açılır, kamera döner
// ============================================================

import "stdlib/graphics";

let RENDER_MODE = "NATIVE"; // <--- BURAYI "WEB" YAPARSANIZ TARAYICIDA AÇILIR

let ground  = addPlane(0, 40, "0x1a1c20");
let grid    = gridHelper(40, 40);

let b1_body = addBox(-8, 4, -2,   2.5, 8, 2.5, "0x1e3a5f");
let b1_top  = addBox(-8, 8.5, -2, 1.8, 1, 1.8, "0x3b82f6");

let b2_body = addBox(-4, 5, 0,    3,   10, 3,  "0x2c0051");
let b2_top  = addBox(-4, 10.5, 0, 2,   1,  2,  "0xa855f7");
let b2_ant  = addCylinder(-4, 12, 0, 0.08, 0.08, 2, "0xc2c6d6");

let b3_body = addBox(0, 7, 0,     4,   14, 4,  "0x111317");
let b3_top  = addBox(0, 14.5, 0,  2.5, 1,  2.5,"0x3b82f6");
let b3_ant  = addCylinder(0, 16, 0, 0.1, 0.1, 3, "0xadc6ff");

let b4_body = addBox(5, 4, -1,    2.5, 8, 2.5, "0x341100");
let b4_top  = addCone(5, 8.5, -1, 1.2, 2,      "0xf97316");

let b5 = addBox(-6, 2, -6,   3, 4, 3, "0x1e2024");
let b6 = addBox(6,  2.5, -5, 2, 5, 2, "0x282a2e");
let b7 = addBox(3,  2, -7,   3, 4, 4, "0x1a1c20");
let b8 = addBox(-2, 1.5, -8, 4, 3, 3, "0x111317");

let s1 = addBox(-10, 1.5, 3, 2, 3, 2, "0x1e2024");
let s2 = addBox(8,   1, 2,   3, 2, 3, "0x282a2e");
let s3 = addBox(-3,  1, 5,   2, 2, 2, "0x1a1c20");

let city = ground + grid
         + b1_body + b1_top
         + b2_body + b2_top + b2_ant
         + b3_body + b3_top + b3_ant
         + b4_body + b4_top
         + b5 + b6 + b7 + b8
         + s1 + s2 + s3;

renderScene3d(70, city);
print("3D City opened in browser!");
