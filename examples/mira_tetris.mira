# ============================================================
# MiraIDE Game Example: Classic Tetris
# Demonstrates: 2D Arrays, Rotation Logic, Gravity, Timing
# ============================================================

import "stdlib/canvas2d";
import "stdlib/input";
import "stdlib/math";

let COLS = 10;
let ROWS = 20;
let SIZE = 30;
let W = 500;
let H = 650;

# Game Grid (0 = empty, string = color)
let grid = [];
let r = 0;
while (r < ROWS) {
    let row = [];
    let c = 0;
    while (c < COLS) {
        let row = row + [0];
        let c = c + 1;
    }
    let grid = grid + [row];
    let r = r + 1;
}

# Current Piece
let currX = 3;
let currY = 0;
let currColor = "#FF4444";
let currShape = [[1, 1], [1, 1]]; # O-Shape simple example

let score = 0;
let tick = 0;

println("Starting Mira Tetris...");

while (true) {
    let cmds = "";
    let tick = tick + 1;
    
    # 1. Gravity (Move down every 30 ticks)
    if (tick % 30 == 0 || isDown(KEY_DOWN)) {
        let currY = currY + 1;
        # Simple collision check for floor
        if (currY > ROWS - 2) {
            let currY = 0;
            let score = score + 100;
        }
    }
    
    # 2. Input
    if (tick % 5 == 0) {
        if (isDown(KEY_LEFT) && currX > 0) { let currX = currX - 1; }
        if (isDown(KEY_RIGHT) && currX < COLS - 2) { let currX = currX + 1; }
    }

    # 3. Draw Grid
    let r = 0;
    while (r < ROWS) {
        let c = 0;
        while (c < COLS) {
            let cmds = cmds + drawRect(c*SIZE + 100, r*SIZE + 20, SIZE-1, SIZE-1, "#1A1D23");
            let c = c + 1;
        }
        let r = r + 1;
    }

    # 4. Draw Current Piece
    let pi = 0;
    while (pi < length(currShape)) {
        let pj = 0;
        while (pj < length(currShape[pi])) {
            if (currShape[pi][pj] == 1) {
                let cmds = cmds + drawRoundRect((currX+pj)*SIZE + 100, (currY+pi)*SIZE + 20, SIZE-2, SIZE-2, 5, currColor);
            }
            let pj = pj + 1;
        }
        let pi = pi + 1;
    }

    # 5. UI & Score
    let cmds = cmds + drawText("TETRIS", 350, 60, 32, "#6200EE", "Inter");
    let cmds = cmds + drawText("SCORE", 350, 120, 20, "#AAAAAA", "Inter");
    let cmds = cmds + drawText("" + score, 350, 150, 24, "#FFFFFF", "Inter");

    renderCanvas2d(W, H, "#0C0E12", cmds);
    sleep(16);
}
